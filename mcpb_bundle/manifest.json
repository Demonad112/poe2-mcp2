    },
    {
      "name": "compare_to_top_players"
    },
    {
      "name": "explain_mechanic"
    },
    {
      "name": "export_pob"
    },
    {
      "name": "find_stat_sources"
    },
    {
      "name": "get_available_mods"
    },
    {
      "name": "get_formula"
    },
    {
