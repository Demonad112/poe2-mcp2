{
  "manifest_version": "0.3",
  "name": "poe2-mcp",
  "version": "1.0.0",
  "description": "AI-powered Path of Exile 2 build optimization MCP server. Community project - not affiliated with Grinding Gear Games.",
  "author": {
    "name": "Demonad112",
    "url": "https://github.com/Demonad112/poe2-mcp2"
  },
  "license": "MIT",
  "homepage": "https://github.com/Demonad112/poe2-mcp2",
  "repository": {
    "type": "git",
    "url": "https://github.com/Demonad112/poe2-mcp2.git"
  },
  "keywords": [
    "path-of-exile",
    "poe2",
    "build-optimizer",
    "gaming",
    "ai"
  ],
  "server": {
    "type": "python",
    "entry_point": "server/launch.py",
    "mcp_config": {
      "command": "python",
      "args": [
        "${__dirname}/server/launch.py"
      ],
      "env": {
        "PYTHONPATH": "${__dirname}/server"
      }
    }
  },
  "tools": [
